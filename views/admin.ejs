<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin</title>
</head>
<body>
    <h1>Submissions</h1>
    <ul>
        <% contacts.forEach(contact => { %>
            <li>
              <p><%= contact.fname %></p>
              <p><%= contact.lname %></p>
              <p><%= contact.job %></p>
              <p><%= contact.company %></p>
              <p><%= contact.linkedIn %></p>
              <p><%= contact.email %></p>
              <p><%= contact.meeting %></p>
              <p><%= contact.other %></p>
              <p><%= contact.message-text %></p>
              <p><%= contact.mailing %></p>
              <p><%= contact.html %></p>
              <p><%= contact.text %></p>
            </li>
        <% }) %>
    </ul>    
</body>
</html>