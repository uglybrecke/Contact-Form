<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin</title>
</head>
<body>
    <h1>Submissions</h1>
    <ul>
        <% contacts.forEach(contact => { %>
            <li>
              <p>First Name: <%= contact.fname %></p>
              <p>last Name: <%= contact.lname %></p>
              <p>Job Name: <%= contact.job %></p>
              <p>Company Name: <%= contact.company %></p>
              <p>LinkedIn: <%= contact.linkedIn %></p>
              <p>Email: <%= contact.email %></p>
              <p>How did we meet: <%= contact.meeting %></p>
              <p>How met if OTHER: <%= contact.other %></p>
              <p>Message: <%= contact.message %></p>
              <p>Mailing: <%= contact.mailing %></p>
              <p>HTML: <%= contact.html %></p>
              <p>TEXT: <%= contact.text %></p>
            </li>
        <% }) %>
    </ul>    
</body>
</html>